<table role="presentation" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td>
      <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
        <tr>
          <td align="center" style="padding-bottom: 20px;">
            <div
              style="width: 60px; height: 60px; background-color: {{warningColor}}; border-radius: 50%; display: inline-block; line-height: 60px; text-align: center;"
            >
              <span
                style="color: {{whiteColor}}; font-size: 30px;"
              >&#9888;</span>
            </div>
          </td>
        </tr>
      </table>

      <h2
        style="margin: 0 0 20px 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 24px; font-weight: 600; color: {{darkColor}}; text-align: center;"
      >
        {{alertType}}
      </h2>

      <p
        style="margin: 0 0 20px 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 16px; line-height: 24px; color: #4B5563;"
      >
        Hi{{{userNameHtml}}},
      </p>

      <p
        style="margin: 0 0 20px 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 16px; line-height: 24px; color: #4B5563;"
      >
        {{message}}
      </p>

      {{{actionButtonHtml}}}
    </td>
  </tr>
</table>