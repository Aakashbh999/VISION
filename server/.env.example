# Database Connection
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# JWT / Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-byte-random-hex

# CORS
# Comma-separated list of allowed frontend origins (used by cors() middleware)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# In production, set to your Vercel URL: CORS_ORIGINS=https://your-app.vercel.app
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Server Configuration
PORT=5000
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=replace-me@example.com
EMAIL_PASS=replace-me
EMAIL_FROM="VISION Support" <replace-me@example.com>